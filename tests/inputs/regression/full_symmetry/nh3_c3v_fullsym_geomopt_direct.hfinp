%begin_control
    basis       sto-3g
    calculation geomopt
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
    scf_mode    direct
    tol_energy  1e-9
    tol_density 1e-9
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .true.
%end_geom

