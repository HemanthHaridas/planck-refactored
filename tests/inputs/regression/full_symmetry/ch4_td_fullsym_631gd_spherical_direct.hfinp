%begin_control
    basis       6-31g*
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
    scf_mode    direct
    tol_energy  1e-10
    tol_density 1e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .true.
%end_geom

