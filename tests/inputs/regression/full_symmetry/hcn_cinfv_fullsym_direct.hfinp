%begin_control
    basis       sto-3g
    calculation energy
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
    scf_mode    direct
    max_cycles  200
    tol_energy  1e-10
    tol_density 1e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .true.
%end_geom

%begin_coords
3
0   1
H     0.000000    0.000000   -1.065000
C     0.000000    0.000000    0.000000
N     0.000000    0.000000    1.153000
%end_coords
