# Spherical DFT checkpoint restart gate (docs/SPHERICAL_DFT.md): seed for the spherical UKS same-basis restart (guess sad: 2B1 ground state).
%begin_control
    basis       6-31g*
    calculation energy
    basis_type  spherical
%end_control
%begin_scf
    scf_type        uhf
    guess           sad
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-9
%end_scf
%begin_dft
    grid        fine
    exchange    pbe
    correlation pbe
    save_checkpoint .true.
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
3
1   2
O     0.000000     0.000000     0.117176
H     0.000000     0.757200    -0.468704
H     0.000000    -0.757200    -0.468704
%end_coords
