# Spherical DFT checkpoint restart gate (docs/SPHERICAL_DFT.md): seed for the spherical RKS projected restart.
%begin_control
    basis       sto-3g
    calculation energy
    basis_type  spherical
%end_control
%begin_scf
    scf_type        rhf
    guess           hcore
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-9
%end_scf
%begin_dft
    grid        fine
    exchange    b3lyp
    correlation lyp
    save_checkpoint .true.
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
3
0   1
O     0.000000     0.000000     0.117176
H     0.000000     0.757200    -0.468704
H     0.000000    -0.757200    -0.468704
%end_coords
