# Seed for hi_rhf_def2svp_ecp_restart_full: writes an ECP checkpoint (version 8).
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
    save_checkpoint .true.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
