# RI under MPI gate (docs/RI_MPI_SCOPE.md M0): copy of tests/inputs/regression/ri/water_casscf_ri_ccpvdz.hfinp with
# checkpoints off, so concurrent ranks write no shared file.
%begin_control
    basis       cc-pvdz
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    save_checkpoint .false.
    correlation casscf
    use_diis    .true.
    diis_dim    8
    engine      os

    nactele     4
    nactorb     4
    nroots      1
    mcscf_max_iter  100
    mcscf_micro_per_macro  4
    tol_mcscf_energy  1e-8
    tol_mcscf_grad    1e-5
    mp2_use_ri .true.
    mp2_ri_basis cc-pVDZ-RIFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .true.
%end_geom

%begin_coords
3
0   1
O    0.000000    0.000000    0.117176
H    0.000000    0.757005   -0.468704
H    0.000000   -0.757005   -0.468704
%end_coords
