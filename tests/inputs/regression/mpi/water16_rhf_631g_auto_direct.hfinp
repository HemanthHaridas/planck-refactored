%begin_control
    basis       6-31g
    calculation energy
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    engine      auto
    scf_mode    direct
    guess       sad
    max_cycles  100
    tol_energy  1e-10
    tol_density 1e-8
    save_checkpoint .false.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

