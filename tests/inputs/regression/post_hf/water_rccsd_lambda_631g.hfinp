# Λ-CCSD gate (docs/CC_LAMBDA_SCOPE.md, 3c): rms of each λ block against the spatial Λ
# equations solved at PySCF RCCSD t (tests/pyscf/cc_lambda_references.py).
%begin_control
    basis       6-31g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    correlation ccsd_gen
    cc_lambda   .true.
    use_diis    .true.
    save_checkpoint .false.
    guess       hcore
    tol_energy  1.0e-11
    tol_density 1.0e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
O     0.000000     0.000000     0.117176
H     0.000000     0.756950    -0.468703
H     0.000000    -0.756950    -0.468703
%end_coords
