# UCCSD(T) gate (docs/CCSD_T_SCOPE.md step 3), against PySCF UCCSD + uccsd_t,
# mol.cart = True, Planck's GBS. Needs -DPLANCK_CC_UCC=ON (generated ucc2).
%begin_control
    basis       6-31g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    uhf
    correlation uccsd(t)
    use_diis    .true.
    diis_dim    8
    save_checkpoint .false.
    guess       sad
    tol_energy  1.0e-11
    tol_density 1.0e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
1   2
O     0.000000     0.000000     0.117176
H     0.000000     0.756950    -0.468703
H     0.000000    -0.756950    -0.468703
%end_coords
