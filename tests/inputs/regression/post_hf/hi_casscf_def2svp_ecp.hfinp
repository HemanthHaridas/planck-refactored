# def2 ECP post-HF gate (docs/DEF2_ECP.md smaller items): HI CASSCF(2,2), H-I sigma/sigma*,
# iodine 28-electron ECP. The ECP enters only through H_core, so the inactive-core Fock and core
# energy carry it. Reference: PySCF 2.13.0 CASSCF, cart=False, basis/ECP from Planck's GBS
# (tests/pyscf/def2_ecp_post_hf_references.py 2 2).
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type        rhf
    guess           hcore
    correlation     casscf
    tol_energy      1.0e-11
    tol_density     1.0e-10
    mcscf_max_iter  200
    nactele         2
    nactorb         2
    nroots          1
    save_checkpoint .false.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
