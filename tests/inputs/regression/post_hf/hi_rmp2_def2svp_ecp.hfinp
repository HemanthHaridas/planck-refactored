# def2 ECP post-HF gate (docs/DEF2_ECP_SCOPE.md smaller items): HI RMP2, iodine 28-electron ECP.
# Electron counts once summed Z and ignored the ECP core: E_corr came out -0.0059849856 (24x too small).
# Reference: PySCF 2.13.0 RMP2, cart=False, basis/ECP from Planck's GBS (def2_ecp_references.py loader).
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type        rhf
    guess           hcore
    correlation     rmp2
    save_checkpoint .false.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
