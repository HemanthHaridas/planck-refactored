# CCSD(T) gate (docs/CCSD_T_SCOPE.md step 4), against PySCF RCCSD + ccsd_t, mol.cart = True.
%begin_control
    basis       6-31g
    calculation energy
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    correlation ccsd(t)
    use_diis    .true.
    save_checkpoint .false.
    guess       hcore
    tol_energy  1.0e-11
    tol_density 1.0e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
4
0   1
O     0.000000     0.717000    -0.041000
O     0.021000    -0.717000     0.032000
H     0.851000     0.887000     0.463000
H    -0.802000    -0.911000     0.395000
%end_coords
