%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    uhf
    correlation ucc2
    use_diis    .true.
    diis_dim    8
    engine      os
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
1   2
O     0.000000    0.000000    0.000000
H     0.000000    0.000000    0.970000
H     0.900000    0.000000   -0.310000
%end_coords
