%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    correlation ccsdt
    # use_diis is LOAD-BEARING here, not a default. The hand-written restricted
    # tensor CCSDT solver (run_restricted_tensor_rccsdt_no_fallback) DIVERGES on
    # this system without it: rms(R3) grows 1.7e-03 -> 6.1e-03 -> 2.4e-02 over
    # three iterations and the run fails. With DIIS it converges in 24 steps to
    # -0.0791116825. This input is shared with ch4_rccsdt_generated_sto3g, whose
    # generated path is indifferent to the setting -- so flipping it to test the
    # generated path silently breaks the hand-written one, which is exactly how
    # it was broken once (70a587d).
    use_diis    .true.
    diis_dim    8
    save_checkpoint .false.
    engine      os
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
5
0   1
C     0.000000     0.000000     0.000000
H     0.000000     0.000000     1.090000
H     1.030000     0.000000    -0.360000
H    -0.510000     0.890000    -0.360000
H    -0.510000    -0.890000    -0.360000
%end_coords
