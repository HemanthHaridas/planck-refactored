# Artificial two-electron ECP control. Rb contributes 37 - 28 = 9; RbH(8+) has 2 electrons.
# The bond gives a nonzero effective nuclear repulsion. Not a chemical benchmark.
%begin_control
    basis       def2-SVP
    calculation energy
    verbosity   normal
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    correlation fci
    save_checkpoint .false.

    use_diis    .true.
    diis_dim    8
    engine      os
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
8   1
Rb 0 0 0
H 0 0 2.4
%end_coords
