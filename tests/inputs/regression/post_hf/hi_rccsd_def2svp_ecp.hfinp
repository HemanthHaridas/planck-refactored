# def2 ECP post-HF gate (docs/DEF2_ECP.md): HI RCCSD, iodine 28-electron ECP.
# Reference: PySCF 2.13.0 CCSD, cart=False, basis/ECP from Planck's GBS
# (tests/pyscf/def2_ecp_post_hf_references.py). Before 2026-11-07 Planck's RCCSD lacked the
# F_me terms of the Stanton-Gauss doubles equation and sat 7.4e-8 above PySCF here.
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type        rhf
    guess           hcore
    correlation     ccsd
    tol_energy      1.0e-11
    tol_density     1.0e-10
    save_checkpoint .false.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
