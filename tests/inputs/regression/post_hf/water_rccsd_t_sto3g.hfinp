# CCSD(T) gate (docs/CCSD_T_SCOPE.md step 4), against PySCF RCCSD + ccsd_t, mol.cart = True.
%begin_control
    basis       sto-3g
    calculation energy
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    correlation ccsd(t)
    use_diis    .true.
    save_checkpoint .false.
    guess       hcore
    tol_energy  1.0e-11
    tol_density 1.0e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
O     0.000000     0.000000     0.117176
H     0.000000     0.756950    -0.468703
H     0.000000    -0.756950    -0.468703
%end_coords
