# Λ-UCCSD gate (docs/CC_LAMBDA_SCOPE.md, 3c): rms of each λ block against PySCF UCCSD
# solve_lambda, which Planck's UCC λ equals unscaled (tests/pyscf/cc_lambda_references.py).
%begin_control
    basis       6-31g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    uhf
    correlation uccsd_gen
    cc_lambda   .true.
    use_diis    .true.
    diis_dim    8
    save_checkpoint .false.
    guess       sad
    tol_energy  1.0e-11
    tol_density 1.0e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   2
O     0.000000     0.000000     0.000000
H     0.000000     0.000000     0.970000
%end_coords
