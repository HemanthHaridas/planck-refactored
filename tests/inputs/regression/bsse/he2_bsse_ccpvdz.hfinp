%begin_control
    basis       cc-pVDZ
    calculation energy
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    use_diis    .true.
    diis_dim    8
    engine      os
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
He    0.000000    0.000000    0.000000
He    0.000000    0.000000    3.000000
%end_coords

%begin_bsse
    fragment      1
    fragment      2
    charge        0 0
    multiplicity  1 1
%end_bsse
