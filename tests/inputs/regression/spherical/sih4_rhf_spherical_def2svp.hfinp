# def2 all-electron cross-code gate (docs/DEF2_ECP.md step 1).
# Reference: tests/pyscf/def2_rhf_references.py (PySCF, cart=False, Planck's own GBS).
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    use_diis    .true.
    diis_dim    8
    guess       hcore
    max_cycles  200
    tol_energy  1.0e-10
    tol_density 1.0e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
5
0   1
Si    0.000000     0.000000     0.000000
H     0.854500     0.854500     0.854500
H    -0.854500    -0.854500     0.854500
H    -0.854500     0.854500    -0.854500
H     0.854500    -0.854500    -0.854500
%end_coords
