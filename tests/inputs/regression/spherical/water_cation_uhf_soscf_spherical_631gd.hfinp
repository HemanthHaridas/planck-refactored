# Spherical SOSCF gate (S0.6): the uhf CPHF orbital Hessian must be built in the working basis; SOSCF converges superlinearly to the DIIS energy.
%begin_control
    basis       6-31g*
    calculation energy
    basis_type  spherical
%end_control
%begin_scf
    scf_type        uhf
    guess           hcore
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-9
    save_checkpoint .false.
    scf_soscf_start 3
%end_scf
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
3
1 2
O 0.000000 0.000000 0.117176
H 0.000000 0.757200 -0.468704
H 0.000000 -0.757200 -0.468704
%end_coords
