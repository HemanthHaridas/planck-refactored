%begin_control
    basis       6-31g*
    calculation energy
    verbosity   normal
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    correlation fci
    use_diis    .true.
    diis_dim    8
    engine      os
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
1
0   1
Be    0.000000     0.000000     0.000000
%end_coords
