# Spherical DFT step 2 gate (docs/SPHERICAL_DFT_SCOPE.md): RKS B3LYP geometry optimization and
# frequencies in a spherical basis vs PySCF cart=False geometric_solver + analytic Hessian
# (tests/pyscf/spherical_ks_gradient_references.py).
%begin_control
    basis       6-31g*
    calculation geomoptfreq
    basis_type  spherical
%end_control
%begin_scf
    scf_type        rhf
    guess           hcore
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-9
    save_checkpoint .false.
%end_scf
%begin_dft
    grid        fine
    grid_radial_points 150
    grid_angular_points 590
    exchange    b3lyp
    correlation lyp
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
3
0   1
O     0.000000     0.000000     0.117300
H     0.000000     0.757200    -0.469200
H     0.000000    -0.757200    -0.469200
%end_coords
