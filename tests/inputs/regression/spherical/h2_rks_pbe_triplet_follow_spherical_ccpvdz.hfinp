# Spherical DFT step 4 gate (docs/SPHERICAL_DFT.md): H2 at 2.5 A, RKS PBE in spherical
# cc-pVDZ, is RKS -> UKS (triplet) unstable; the follow promotes to UKS and must reach PySCF
# cart=False's broken-symmetry UKS (tests/pyscf/spherical_ks_stability_references.py).
%begin_control
    basis       cc-pVDZ
    calculation energy
    basis_type  spherical
%end_control
%begin_scf
    scf_type         rhf
    guess            hcore
    max_cycles       200
    tol_energy       1.0e-10
    tol_density      1.0e-9
    save_checkpoint  .false.
    stability_check  .true.
    stability_follow .true.
%end_scf
%begin_dft
    grid        fine
    grid_radial_points 150
    grid_angular_points 590
    exchange    pbe
    correlation pbe
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
2
0 1
H 0 0 0
H 0 0 2.5
%end_coords
