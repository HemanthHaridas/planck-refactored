# Spherical HF stability gate (S0.6): water+ UHF/6-31G* spherical from hcore sits on a saddle; the follow reaches PySCF cart=False's UHF ground state.
%begin_control
    basis       6-31g*
    calculation energy
    basis_type  spherical
%end_control
%begin_scf
    scf_type        uhf
    guess           hcore
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-9
    save_checkpoint .false.
    stability_check .true.
    stability_follow .true.
%end_scf
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
3
1 2
O 0.000000 0.000000 0.117176
H 0.000000 0.757200 -0.468704
H 0.000000 -0.757200 -0.468704
%end_coords
