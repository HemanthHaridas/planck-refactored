# Spherical DFT step 3 gate (docs/SPHERICAL_DFT.md): TDDFT in a spherical basis vs PySCF
# cart=False (tests/pyscf/spherical_tddft_references.py), matched 150 x 590 unpruned grid.
%begin_control
    basis       6-31g*
    calculation tddft
    basis_type  spherical
%end_control
%begin_scf
    scf_type        rhf
    guess           hcore
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-10
    save_checkpoint .false.
%end_scf
%begin_dft
    grid        fine
    grid_radial_points 150
    grid_angular_points 590
    exchange    hse06
    correlation pbe
    lr_nstates  4
    lr_spin     singlet
    lr_method   casida
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
3
0   1
O     0.000000    0.000000     0.117176
H     0.000000    0.756950    -0.468703
H     0.000000   -0.756950    -0.468703
%end_coords
