# Spherical DFT checkpoint restart gate (docs/SPHERICAL_DFT.md): a spherical 6-31G* restart from a Cartesian checkpoint is refused and falls back to H_core.
%begin_control
    basis       6-31g*
    calculation energy
    basis_type  spherical
%end_control
%begin_scf
    scf_type        rhf
    guess           density
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-9
    save_checkpoint .false.
%end_scf
%begin_dft
    grid        fine
    exchange    b3lyp
    correlation lyp
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
3
0   1
O     0.000000     0.000000     0.117176
H     0.000000     0.757200    -0.468704
H     0.000000    -0.757200    -0.468704
%end_coords
