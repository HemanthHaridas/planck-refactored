# Boundary marker: spherical RI-MP2 gradients stay refused. The spherical RI
# derivative lift is exact (docs/RI_JK_ROUTINE_SCOPE.md step 16), but the RI-MP2
# gradient itself misses its own energy FD by ~4e-6 Ha/Bohr, Cartesian too.
%begin_control
    basis       6-31g*
    calculation gradient
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    correlation rmp2
    mp2_use_ri      .true.
    mp2_ri_basis    cc-pVDZ-RIFIT
    guess       hcore
    max_cycles  100
    tol_energy  1.0e-12
    tol_density 1.0e-11
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
O     0.000000     0.000000     0.117176
H     0.000000     0.757200    -0.468704
H     0.000000    -0.757200    -0.468704
%end_coords
