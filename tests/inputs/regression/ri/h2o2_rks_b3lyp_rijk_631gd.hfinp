# RI-JK Kohn-Sham gate (docs/RI_JK_ROUTINE_SCOPE.md step 13): C1 H2O2 RKS B3LYP,
# def2-universal-JKFIT, unpruned 150 x 590 grid, against PySCF
# dft.RKS/UKS(...).density_fit() (tests/pyscf/ri_jk_dft_references.py).
%begin_control
    basis       6-31g*
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type          rhf
    guess             hcore
    max_cycles        100
    tol_energy        1.0e-10
    tol_density       1.0e-10
    save_checkpoint   .false.
    scf_ri_jk         .true.
    mp2_ri_basis      def2-universal-JKFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_dft
    grid                fine
    grid_radial_points  150
    grid_angular_points 590
    exchange            b3lyp
    correlation         lyp
    print_grid_summary  .false.
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
4
0 1
O 0.000000 0.700000 -0.050000
O 0.020000 -0.710000 0.040000
H 0.880000 0.900000 0.420000
H -0.650000 -0.950000 0.780000
%end_coords
