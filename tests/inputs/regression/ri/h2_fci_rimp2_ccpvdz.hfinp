%begin_control
    basis       cc-pVDZ
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type          rhf
    correlation       fci
    engine            os
    guess             hcore
    save_checkpoint   .false.
    mp2_use_ri        .true.
    mp2_ri_basis      cc-pVDZ-RIFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000    -0.370500
H     0.000000     0.000000     0.370500
%end_coords
