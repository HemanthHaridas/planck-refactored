# RI-JK SCF gate (docs/RI_JK_ROUTINE_SCOPE.md step 1): scf_ri_jk with the
# def2-universal-JKFIT fitting basis (contracted aux shells), against PySCF density_fit with the same
# orbital and auxiliary bases read from Planck's GBS files
# (tests/pyscf/ri_jk_references.py).
%begin_control
    basis       6-31g*
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type          uhf
    guess             hcore
    max_cycles        100
    tol_energy        1.0e-10
    tol_density       1.0e-10
    save_checkpoint   .false.
    scf_ri_jk         .true.
    mp2_ri_basis      def2-universal-JKFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
4
1 2
O 0.000000 0.700000 -0.050000
O 0.020000 -0.710000 0.040000
H 0.880000 0.900000 0.420000
H -0.650000 -0.950000 0.780000
%end_coords
