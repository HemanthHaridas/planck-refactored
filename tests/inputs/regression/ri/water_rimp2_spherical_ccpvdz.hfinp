# Spherical RI-MP2 (docs/RI_SPHERICAL_AUX.md): the fitted aux follows
# basis_type, so this equals PySCF DF-MP2 on a cart=False molecule with the
# same GBS-read cc-pVDZ / cc-pVDZ-RIFIT. Exact SCF, RI only in MP2.
%begin_control
    basis       cc-pVDZ
    calculation energy
    verbosity   normal
    basis_type  spherical
%end_control

%begin_scf
    scf_type         rhf
    correlation      rmp2
    use_diis         .true.
    diis_dim         8
    engine           os
    guess            hcore
    tol_energy       1.0e-10
    tol_density      1.0e-10
    save_checkpoint  .false.
    mp2_use_ri       .true.
    mp2_ri_basis     cc-pVDZ-RIFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
