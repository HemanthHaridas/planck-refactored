# RI-JK gradient gate (docs/RI_JK_ROUTINE_SCOPE.md step 10): water cation UHF
# analytic gradient on the fitted operator, def2-universal-JKFIT, against
# PySCF mf.density_fit().nuc_grad_method() (tests/pyscf/ri_jk_gradient_references.py).
%begin_control
    basis       6-31g*
    calculation gradient
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type          uhf
    guess             hcore
    max_cycles        100
    tol_energy        1.0e-10
    tol_density       1.0e-10
    save_checkpoint   .false.
    scf_ri_jk         .true.
    mp2_ri_basis      def2-universal-JKFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
1 2
O 0.000000 0.000000 0.000000
H 0.758602 0.000000 0.504284
H -0.758602 0.000000 0.504284
%end_coords
