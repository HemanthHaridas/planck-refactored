%begin_control
    basis       cc-pVDZ
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type         uhf
    correlation      ump2
    use_diis         .true.
    diis_dim         8
    engine           os
    guess            hcore
    level_shift      0.3
    diis_restart     2.0
    save_checkpoint  .false.
    mp2_use_ri       .true.
    mp2_ri_basis     cc-pVDZ-RIFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
1   2
O     0.000000    0.000000     0.117176
H     0.000000    0.756950    -0.468703
H     0.000000   -0.756950    -0.468703
%end_coords
