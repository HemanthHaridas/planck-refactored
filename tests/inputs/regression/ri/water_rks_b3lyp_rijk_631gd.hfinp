# RI-JK Kohn-Sham gate (docs/RI_JK_ROUTINE.md step 13): water RKS B3LYP (RI-J + RI-K),
# def2-universal-JKFIT, unpruned 150 x 590 grid, against PySCF
# dft.RKS/UKS(...).density_fit() (tests/pyscf/ri_jk_dft_references.py).
%begin_control
    basis       6-31g*
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type          rhf
    guess             hcore
    max_cycles        100
    tol_energy        1.0e-10
    tol_density       1.0e-10
    save_checkpoint   .false.
    scf_ri_jk         .true.
    mp2_ri_basis      def2-universal-JKFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_dft
    grid                fine
    grid_radial_points  150
    grid_angular_points 590
    exchange            b3lyp
    correlation         lyp
    print_grid_summary  .false.
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0 1
O 0.000000 0.000000 0.000000
H 0.758602 0.000000 0.504284
H -0.758602 0.000000 0.504284
%end_coords
