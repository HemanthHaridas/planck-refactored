%begin_control
    basis       cc-pVDZ
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type         rhf
    correlation      rmp2
    use_diis         .true.
    diis_dim         8
    engine           os
    guess            hcore
    save_checkpoint  .false.
    mp2_use_ri       .true.
    mp2_ri_basis     cc-pVDZ-RIFIT
    mp2_ri_basis_path basis-sets
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
-1   1
C      0.000000     0.000000     0.000000
N      0.000000     0.000000     1.171800
%end_coords
