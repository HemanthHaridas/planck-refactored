%begin_control
    basis             sto-3g
    calculation       energy
    verbosity         normal
    basis_type        cartesian
%end_control

%begin_scf
    scf_type        rhf
    use_diis        .true.
    diis_dim        8
    engine          os
    guess           hcore
    save_checkpoint .false.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

# RESP charges (docs/ESP_CHARGES_SCOPE.md, E4b/E5): the Connolly fit plus the
# Bayly hyperbolic restraint. `equivalent 2 3` forces water's two symmetry-
# equivalent hydrogens to share a charge exactly -- without it the grid samples
# them slightly differently and the fit gives them different values.
#
# resp_strength is raised well above the Bayly stage-1 default of 0.0005 so the
# restraint's effect is visible in the printed charges rather than sitting below
# the print precision.
%begin_esp
    grid             connolly
    shell_scales     1.4 1.6 1.8 2.0
    points_per_shell 200
    resp             .true.
    resp_strength    0.01
    resp_tightness   0.1
    equivalent       2 3
%end_esp

%begin_coords
3
0   1
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
