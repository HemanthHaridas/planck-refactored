%begin_control
    basis             sto-3g
    calculation       energy
    verbosity         normal
    basis_type        cartesian
%end_control

%begin_scf
    scf_type        rhf
    use_diis        .true.
    diis_dim        8
    engine          os
    guess           hcore
    save_checkpoint .false.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

# CHELPG charges (docs/ESP_CHARGES_SCOPE.md, E3). Breneman & Wiberg 1990
# defaults: 0.3 A lattice spacing, 2.8 A of head-space beyond the van der Waals
# surface, points inside any atom's vdW radius discarded.
%begin_esp
    grid            chelpg
    grid_spacing    0.3
    grid_headspace  2.8
    radius_scale    1.0
%end_esp

%begin_coords
3
0   1
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
