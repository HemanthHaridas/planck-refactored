%begin_control
    basis             sto-3g
    calculation       energy
    verbosity         normal
    basis_type        cartesian
%end_control

%begin_scf
    scf_type        rhf
    use_diis        .true.
    diis_dim        8
    engine          os
    guess           hcore
    save_checkpoint .false.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

# Connolly / Merz-Kollman sampling shells (docs/ESP_CHARGES_SCOPE.md, E4a).
# Nested spheres at 1.4/1.6/1.8/2.0 x the vdW radius. Unlike the CHELPG cubic
# lattice this construction is rotationally symmetric, so the fitted charges do
# not depend on the molecule's orientation in the lab frame.
%begin_esp
    grid             connolly
    shell_scales     1.4 1.6 1.8 2.0
    points_per_shell 200
    radius_scale     1.0
%end_esp

%begin_coords
3
0   1
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
