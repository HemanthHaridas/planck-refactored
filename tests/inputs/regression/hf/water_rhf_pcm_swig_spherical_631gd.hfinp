# SWIG C-PCM gate (docs/PCM_GEOMETRY.md step 6, spherical). Reference:
# tests/pyscf/pcm_swig_references.py.
%begin_control
    basis       6-31g*
    calculation energy
    verbosity   normal
    basis_type  spherical
%end_control

%begin_scf
    scf_type        rhf
    guess           hcore
    max_cycles      100
    tol_energy      1.0e-10
    tol_density     1.0e-10
%end_scf

%begin_pcm
    model                   pcm
    solvent                 water
    cavity_scale            1.2
    surface_points_per_atom 302
%end_pcm

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
