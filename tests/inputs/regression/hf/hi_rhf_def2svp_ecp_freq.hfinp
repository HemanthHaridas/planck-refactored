# def2 ECP frequency gate (docs/DEF2_ECP_SCOPE.md step 5): HI, iodine 28-electron ECP.
# Reference: PySCF 2.13.0 (geometric_solver / FD-of-analytic Hessian), same GBS file; see regression_cases.json.
%begin_control
    basis       def2-SVP
    calculation frequency
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
