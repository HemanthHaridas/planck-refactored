# SWIG C-PCM smoothness scan base input (docs/PCM_GEOMETRY_SCOPE.md step 1).
# tests/pcm_smoothness_scan.py stretches the first H along its O-H bond.
%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
    max_cycles  100
    tol_energy  1.0e-11
    tol_density 1.0e-11
%end_scf

%begin_pcm
    model                   pcm
    solvent                 water
    surface_points_per_atom 110
%end_pcm

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
