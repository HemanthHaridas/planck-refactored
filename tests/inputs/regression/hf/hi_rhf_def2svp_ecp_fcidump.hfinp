# FCIDUMP of a valence-only ECP Hamiltonian (docs/DEF2_ECP_SCOPE.md step 4b).
# Checked against PySCF by tests/pyscf/def2_ecp_references.py --fcidump.
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
    fcidump     tests/inputs/regression/hf/hi_rhf_def2svp_ecp_fcidump.fcidump
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
