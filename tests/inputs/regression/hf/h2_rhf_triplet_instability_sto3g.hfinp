# RHF -> UHF stability gate (docs/KS_STABILITY_SCOPE.md R0): stretched H2 (2.5 A) is the textbook
# triplet instability; the channel must be A^T + B^T (PySCF rhf_external), not A^T - B^T.
%begin_control
    basis       sto-3g
    calculation energy
    basis_type  cartesian
%end_control
%begin_scf
    scf_type        rhf
    guess           hcore
    tol_energy      1.0e-11
    tol_density     1.0e-10
    save_checkpoint .false.
    stability_check .true.
%end_scf
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
2
0   1
H 0 0 0
H 0 0 2.5
%end_coords
