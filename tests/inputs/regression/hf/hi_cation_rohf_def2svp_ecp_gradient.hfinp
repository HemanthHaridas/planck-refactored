# def2 ECP gradient gate (docs/DEF2_ECP_SCOPE.md step 5): HI+ doublet, rohf, iodine 28-electron ECP.
# Reference: PySCF 2.13.0 rohf analytic gradient, same GBS file (def2_ecp_references.py loader).
%begin_control
    basis       def2-SVP
    calculation gradient
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rohf
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
1   2
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
