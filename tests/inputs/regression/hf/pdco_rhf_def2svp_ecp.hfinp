# def2 ECP gate (docs/DEF2_ECP.md step 4): PdCO, two neighbours of the ECP atom, SAD guess
# Reference: tests/pyscf/def2_ecp_references.py (PySCF 2.13.0, same GBS file).
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    guess       sad
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
Pd    0.000000     0.000000     0.000000
C     0.000000     0.000000     1.870000
O     0.000000     0.000000     3.010000
%end_coords
