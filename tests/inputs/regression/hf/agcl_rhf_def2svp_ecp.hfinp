# def2 ECP gate (docs/DEF2_ECP_SCOPE.md step 4): AgCl, ECP atom bonded to an all-electron atom
# Reference: tests/pyscf/def2_ecp_references.py (PySCF 2.13.0, same GBS file).
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
Ag    0.000000     0.000000     0.000000
Cl    0.000000     0.000000     2.281000
%end_coords
