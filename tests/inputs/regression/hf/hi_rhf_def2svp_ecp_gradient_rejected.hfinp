# Boundary marker (docs/DEF2_ECP_SCOPE.md step 5): no ECP nuclear derivative
# yet, so gradient-consuming workflows refuse an ECP basis.
%begin_control
    basis       def2-SVP
    calculation gradient
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
