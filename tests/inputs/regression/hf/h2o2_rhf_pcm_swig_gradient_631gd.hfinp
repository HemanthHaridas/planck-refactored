# SWIG C-PCM gate (docs/PCM_GEOMETRY.md step 4d, gradient). Reference:
# tests/pyscf/pcm_swig_references.py.
%begin_control
    basis       6-31g*
    calculation gradient
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type        rhf
    guess           hcore
    max_cycles      100
    tol_energy      1.0e-10
    tol_density     1.0e-10
%end_scf

%begin_pcm
    model                   pcm
    solvent                 water
    cavity_scale            1.2
    surface_points_per_atom 302
%end_pcm

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
4
0   1
O      0.000000     0.700000    -0.050000
O      0.020000    -0.710000     0.040000
H      0.880000     0.900000     0.420000
H     -0.650000    -0.950000     0.780000
%end_coords
