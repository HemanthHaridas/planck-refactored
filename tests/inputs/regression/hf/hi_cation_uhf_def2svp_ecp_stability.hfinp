# def2 ECP stability gate (docs/KS_STABILITY_SCOPE.md): HI+ doublet UHF, iodine 28-electron ECP.
# lambda_min is the zero mode of the degenerate Pi hole, so the check must report stable.
# Electron counts once ignored the ECP core: lambda came out -0.1865 [UNSTABLE] and the follow raised E by 0.14 Eh.
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type        uhf
    guess           hcore
    save_checkpoint .false.
    stability_check .true.
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
1   2
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
