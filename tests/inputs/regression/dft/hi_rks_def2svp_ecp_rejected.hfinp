# Boundary marker (docs/DEF2_ECP_SCOPE.md step 6): planck-dft refuses an ECP
# basis until DFT with ECPs is validated (H_core already carries the ECP).
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    guess       hcore
%end_scf

%begin_dft
    grid                coarse
    exchange            pbe
    correlation         pbe
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
