%begin_control
    basis       6-31g*
    calculation geomoptfreq
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    use_diis    .true.
    diis_dim    6
    engine      os
    guess       hcore
    max_cycles  100
    tol_energy  1.0e-9
    tol_density 1.0e-9
%end_scf

%begin_dft
    grid                fine
    exchange            hse06
    correlation         pbe
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
O     0.000000     0.000000     0.117300
H     0.000000     0.757200    -0.469200
H     0.000000    -0.757200    -0.469200
%end_coords
