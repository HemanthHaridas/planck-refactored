# DFT counterpoise gate (docs/DFT_COUNTERPOISE.md §1).
# Reference: tests/pyscf/cp_dft_references.py.
%begin_control
    basis       cc-pvdz
    calculation energy
    verbosity   normal
    basis_type  spherical
%end_control

%begin_scf
    scf_type        rhf
    max_cycles      100
    tol_energy      1.0e-10
    tol_density     1.0e-10
%end_scf

%begin_dft
    grid                fine
    grid_radial_points  150
    grid_angular_points 590
    exchange            b3lyp
    correlation         lyp
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
He    0.000000    0.000000    0.000000
He    0.000000    0.000000    3.000000
%end_coords

%begin_bsse
    fragment      1
    fragment      2
    charge        0 0
    multiplicity  1 1
%end_bsse
