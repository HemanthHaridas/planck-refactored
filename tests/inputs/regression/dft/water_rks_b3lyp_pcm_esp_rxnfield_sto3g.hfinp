%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type        rhf
    use_diis        .true.
    diis_dim        8
    engine          os
    guess           hcore
    save_checkpoint .false.
%end_scf

%begin_dft
    grid        fine
    exchange    b3lyp
    correlation pbe
%end_dft

%begin_pcm
    model       pcm
    solvent     water
    cavity_scale 1.2
    surface_points_per_atom 24
%end_pcm

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

# The DFT side of `include_reaction_field` (docs/ESP_CHARGES.md section 6item
# (b)). This is a DISTINCT code path from the HF case, not a duplicate of it:
# `prepared` -- which held the shell pairs and the PCM state -- is local to the
# inner run() and already dead by the time the report runs, so log_esp_report_dft
# rebuilds BOTH, including the cavity (one AO matrix per tessera). The HF driver
# still holds its state at the call site and rebuilds nothing. Only this case
# exercises the rebuild.
#
# As in the HF case, the near-zero charges and RRMS ~1.0 are the screening
# physics, not a defect -- see water_rhf_pcm_esp_rxnfield_sto3g for the
# explicit-point evidence.
%begin_esp
    grid                   connolly
    shell_scales           1.4 1.6 1.8 2.0
    points_per_shell       200
    include_reaction_field .true.
%end_esp

%begin_coords
3
0   1
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
