# Boundary marker (docs/KS_STABILITY_SCOPE.md): planck-dft stability analysis is UKS-only until R1/R2.
%begin_control
    basis       6-31g*
    calculation energy
    basis_type  cartesian
%end_control
%begin_scf
    scf_type        rhf
    guess           hcore
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-9
    save_checkpoint .false.
    stability_check .true.
%end_scf
%begin_dft
    grid        fine
    exchange    hse06
    correlation pbe
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
3
0   1
O 0.000000 0.000000 0.000000
H 0.758602 0.000000 0.504284
H -0.758602 0.000000 0.504284
%end_coords
