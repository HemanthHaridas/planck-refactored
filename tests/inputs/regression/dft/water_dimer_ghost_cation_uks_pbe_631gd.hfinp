# Ghost-atom DFT gate (docs/DFT_COUNTERPOISE_SCOPE.md step 1): water dimer,
# second monomer ghosted. Reference: tests/pyscf/ghost_dft_references.py.
%begin_control
    basis       6-31g*
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type        uhf
    guess           sad
    max_cycles      100
    tol_energy      1.0e-10
    tol_density     1.0e-10
%end_scf

%begin_dft
    grid                fine
    grid_radial_points  150
    grid_angular_points 590
    exchange            pbe
    correlation         pbe
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
6
1   2
O        -1.551007    -0.114520     0.000000
H        -1.934259     0.762503     0.000000
H        -0.599677     0.040712     0.000000
Gh(O)     1.350625     0.111469     0.000000
Gh(H)     1.680398    -0.373741    -0.758561
Gh(H)     1.680398    -0.373741     0.758561
%end_coords
