%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    uhf
    use_diis    .true.
    diis_dim    6
    engine      os
    level_shift 0.2
    guess       hcore
    max_cycles  80
    tol_energy  1.0e-8
    tol_density 1.0e-8
%end_scf

%begin_dft
    grid                coarse
    exchange            hse06
    correlation         pbe
    print_grid_summary  .false.
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
1   2
H     0.000000     0.000000    -0.450000
H     0.000000     0.000000     0.450000
%end_coords
