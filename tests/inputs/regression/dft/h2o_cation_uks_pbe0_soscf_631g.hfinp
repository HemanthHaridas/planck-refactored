%begin_control
    basis       6-31g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type          uhf
    use_diis          .true.
    diis_dim          6
    engine            os
    guess             hcore
    max_cycles        100
    tol_energy        1.0e-9
    tol_density       1.0e-9
    scf_soscf_start   5
    scf_soscf_cycles  3
%end_scf

%begin_dft
    grid         normal
    exchange     pbe0
    correlation  pbe
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
1   2
O     0.000000     0.000000     0.000000
H     0.758602     0.000000     0.504284
H    -0.758602     0.000000     0.504284
%end_coords
