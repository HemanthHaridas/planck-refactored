# D3 dispersion gate (docs/DISPERSION_D3.md). References:
# tests/pyscf/d3_references.py.
%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type        uhf
    guess           hcore
    max_cycles      100
    tol_energy      1.0e-10
    tol_density     1.0e-10
%end_scf

%begin_dft
    grid                fine
    grid_radial_points  150
    grid_angular_points 590
    exchange            b3lyp
    correlation         lyp
    dispersion          d3bj
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
1   2
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
