%begin_control
    basis       sto-3g
    calculation tddft
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    use_diis    .true.
    diis_dim    6
    engine      os
    guess       hcore
    max_cycles  80
    tol_energy  1.0e-10
    tol_density 1.0e-10
%end_scf

%begin_dft
    grid                ultrafine
    exchange            hse06
    correlation         pbe
    lr_nstates          4
    lr_spin             triplet
    lr_method           casida
    print_grid_summary  .false.
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
O     0.000000    0.000000     0.117176
H     0.000000    0.756950    -0.468703
H     0.000000   -0.756950    -0.468703
%end_coords
