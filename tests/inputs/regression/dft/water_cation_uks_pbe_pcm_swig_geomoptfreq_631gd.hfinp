# SWIG C-PCM gate (docs/PCM_GATING.md). Reference:
# tests/pyscf/pcm_swig_references.py.
%begin_control
    basis       6-31g*
    calculation geomoptfreq
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type        uhf
    guess           sad
    max_cycles      100
    tol_energy      1.0e-10
    tol_density     1.0e-10
%end_scf

%begin_dft
    grid                fine
    grid_radial_points  150
    grid_angular_points 590
    exchange            pbe
    correlation         pbe
%end_dft

%begin_pcm
    model                   pcm
    solvent                 water
    cavity_scale            1.2
    surface_points_per_atom 302
%end_pcm

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
    geomopt_grad_tol 1.5e-5   # PySCF gau_tight max force, so G_pcm is comparable
%end_geom

%begin_coords
3
1   2
O      0.000000     0.000000     0.000000
H      0.758602     0.000000     0.504284
H     -0.758602     0.000000     0.504284
%end_coords
