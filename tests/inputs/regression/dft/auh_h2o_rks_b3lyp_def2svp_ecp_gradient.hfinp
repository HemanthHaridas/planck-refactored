# def2 ECP DFT gate (docs/DEF2_ECP.md step 6): gradient, spherical def2-SVP, matched 150 x 590 grid,
# vs PySCF cart=False with the ECP read from Planck's GBS (tests/pyscf/def2_ecp_dft_references.py).
%begin_control
    basis       def2-SVP
    calculation gradient
    basis_type  spherical
%end_control
%begin_scf
    scf_type        rhf
    guess           hcore
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-10
%end_scf
%begin_dft
    grid        fine
    grid_radial_points 150
    grid_angular_points 590
    exchange    b3lyp
    correlation lyp
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
5
0   1
Au    0.000000     0.000000     0.000000
H     0.000000     0.000000     1.524000
O     2.300000     0.400000    -0.900000
H     2.900000     1.100000    -0.600000
H     2.700000    -0.400000    -0.500000
%end_coords
