# def2 ECP DFT gate (docs/DEF2_ECP_SCOPE.md step 6): energy, spherical def2-SVP, matched 150 x 590 grid,
# vs PySCF cart=False with the ECP read from Planck's GBS (tests/pyscf/def2_ecp_dft_references.py).
# tol_density 1e-6: the hole sits in a degenerate pi pair, so the density is not unique and wanders
# while the energy holds to 1e-10; that rotation is the zero mode the stability check must report.
%begin_control
    basis       def2-SVP
    calculation energy
    basis_type  spherical
%end_control
%begin_scf
    scf_type        uhf
    guess           sad
    max_cycles      200
    tol_energy      1.0e-10
    tol_density     1.0e-6
    stability_check .true.
%end_scf
%begin_dft
    grid        fine
    grid_radial_points 150
    grid_angular_points 590
    exchange    pbe
    correlation pbe
%end_dft
%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom
%begin_coords
2
1   2
H     0.000000     0.000000     0.000000
I     0.000000     0.000000     1.609000
%end_coords
