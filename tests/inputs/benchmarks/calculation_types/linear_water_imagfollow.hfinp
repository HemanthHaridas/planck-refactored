%begin_control
    basis       sto-3g
    calculation imagfollow
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    use_diis    .true.
    diis_dim    8
    engine      os
    guess       hcore
%end_scf

%begin_geom
    coord_type       cartesian
    coord_units      angstrom
    use_symm         .false.
    imag_follow_step 0.10
%end_geom

%begin_coords
3
0   1
O     0.000000     0.000000     0.000000
H     0.000000     0.000000     1.000000
H     0.000000     0.000000    -1.000000
%end_coords
