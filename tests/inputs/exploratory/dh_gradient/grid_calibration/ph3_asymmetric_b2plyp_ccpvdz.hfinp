%begin_control
    basis       cc-pVDZ
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    use_diis    .true.
    diis_dim    8
    engine      os
    tol_eri     1.0e-14
    guess       hcore
    max_cycles  200
    scf_soscf_start  5
    scf_soscf_cycles 30
    tol_energy  1.0e-11
    tol_density 1.0e-11
%end_scf

%begin_dft
    grid                ultrafine
    exchange            b2plyp
    correlation         pbe
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
4
0 1
P 0.018 -0.052 0.097
H 0.931 0.423 -0.237
H -0.642 0.718 0.364
H -0.281 -0.754 -0.419
%end_coords
