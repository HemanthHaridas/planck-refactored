%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    use_diis    .true.
    diis_dim    6
    engine      os
    guess       hcore
    max_cycles  100
    tol_energy  1.0e-10
    tol_density 1.0e-10
%end_scf

%begin_dft
    grid                ultrafine
    exchange            b2plyp
    correlation         pbe
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
4
0   1
O     0.013000     0.731000    -0.052000
O     0.036000    -0.701000     0.046000
H     0.873000     0.903000     0.487000
H    -0.779000    -0.895000     0.374000
%end_coords
