%begin_control
 basis sto-3g
 calculation energy
 basis_type cartesian
%end_control
%begin_scf
 scf_type rhf
 use_diis .true.
 diis_dim 8
 guess hcore
 max_cycles 200
 tol_energy 1.0e-10
 tol_density 1.0e-10
%end_scf
%begin_dft
 grid ultrafine
 exchange b2plyp
 correlation pbe
%end_dft
%begin_geom
 coord_type cartesian
 coord_units angstrom
 use_symm .false.
%end_geom
%begin_coords
3
0 1
O 0.031 -0.024 0.018
H 0.787 0.094 0.569
H -0.622 0.518 0.436
%end_coords
