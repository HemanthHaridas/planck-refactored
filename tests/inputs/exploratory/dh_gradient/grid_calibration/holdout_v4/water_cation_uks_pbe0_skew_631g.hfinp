%begin_control
 basis 6-31g
 calculation energy
 basis_type cartesian
%end_control
%begin_scf
 scf_type uhf
 use_diis .true.
 diis_dim 8
 guess hcore
 scf_soscf_start 5
 scf_soscf_cycles 3
 max_cycles 400
 tol_energy 1.0e-9
 tol_density 1.0e-9
%end_scf
%begin_dft
 grid ultrafine
 exchange pbe0
 correlation pbe
%end_dft
%begin_geom
 coord_type cartesian
 coord_units angstrom
 use_symm .false.
%end_geom
%begin_coords
3
1 2
O 0.018 -0.027 0.011
H 0.789 0.064 0.532
H -0.713 0.447 0.468
%end_coords
