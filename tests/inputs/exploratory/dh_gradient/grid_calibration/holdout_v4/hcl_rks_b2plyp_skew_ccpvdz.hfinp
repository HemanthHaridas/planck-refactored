%begin_control
 basis cc-pVDZ
 calculation energy
 basis_type cartesian
%end_control
%begin_scf
 scf_type rhf
 use_diis .true.
 diis_dim 8
 guess hcore
 max_cycles 200
 tol_energy 1.0e-10
 tol_density 1.0e-10
%end_scf
%begin_dft
 grid ultrafine
 exchange b2plyp
 correlation pbe
%end_dft
%begin_geom
 coord_type cartesian
 coord_units angstrom
 use_symm .false.
%end_geom
%begin_coords
2
0 1
H -0.641 0.118 -0.091
Cl 0.782 -0.071 0.149
%end_coords
