%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    uhf
    use_diis    .true.
    diis_dim    8
    engine      os
    tol_eri     1.0e-14
    guess       hcore
    max_cycles  200
    scf_soscf_start  5
    scf_soscf_cycles 30
    tol_energy  1.0e-11
    tol_density 1.0e-11
%end_scf

%begin_dft
    grid                ultrafine
    exchange            b2plyp
    correlation         pbe
%end_dft

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0 2
C -0.631 0.117 -0.084
N 0.702 -0.046 0.139
%end_coords
