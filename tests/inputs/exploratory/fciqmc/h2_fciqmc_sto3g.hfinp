# H2/STO-3G FCIQMC -- the F5.1 plumbing check.
#
# 4 determinants, so deterministic FCI is exact and instant. A disagreement here
# is INTEGRAL PLUMBING, not sampling: run_fciqmc and run_fci consume the same
# build_all_mo_ci_setup, so they cannot differ about the Hamiltonian.
#
# Reference (correlation fci on this geometry): -1.1372744062 Eh
#
# NOT a regression case. 4 determinants is far below where sampling means
# anything -- the walker population covers the whole space -- so this validates
# plumbing only. The real gate is N2/STO-3G, see docs/FCIQMC_F5_DRIVER_SCOPE.md.

%begin_control
    basis       sto-3g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    correlation fciqmc
    ci_max_dim  200000
    use_diis    .true.
    diis_dim    8
    save_checkpoint .false.
    engine      os
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
2
0   1
H     0.000000     0.000000     0.000000
H     0.000000     0.000000     0.740000
%end_coords
