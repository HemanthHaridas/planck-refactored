%begin_control
    basis       6-31g
    calculation energy
    verbosity   normal
    basis_type  cartesian
%end_control

%begin_scf
    scf_type    rhf
    correlation fci
    ci_max_dim  200000
    use_diis    .true.
    diis_dim    8
    save_checkpoint .false.
    engine      os
    guess       hcore
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

%begin_coords
3
0   1
Be    0.000000     0.000000     0.000000
H     0.000000     0.000000     1.334000
H     0.000000     0.000000    -1.334000
%end_coords
