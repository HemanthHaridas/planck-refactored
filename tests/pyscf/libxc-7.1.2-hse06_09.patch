diff --git a/src/gga_x_wpbeh09.c b/src/gga_x_wpbeh09.c
new file mode 100644
index 000000000..c41366127
--- /dev/null
+++ b/src/gga_x_wpbeh09.c
@@ -0,0 +1,43 @@
+/*
+ This Source Code Form is subject to the terms of the Mozilla Public
+ License, v. 2.0. If a copy of the MPL was not distributed with this
+ file, You can obtain one at http://mozilla.org/MPL/2.0/.
+*/
+
+#include "util.h"
+
+#define XC_GGA_X_WPBEH09 790 /* short-range PBE hole, smooth reduced-gradient scaling of Henderson et al 2009 */
+
+/* gga_x_wpbeh with eq. (9) of TM Henderson, AF Izmaylov, G Scalmani and
+   GE Scuseria, J. Chem. Phys. 131, 044108 (2009) in place of eq. (8).
+   That paper recommends eq. (9) "due to the discontinuities in s-bar at
+   s = 1" of eq. (8). Everything else is gga_x_wpbeh. */
+
+#include "maple2c/gga_exc/gga_x_wpbeh09.c"
+#include "work_gga.c"
+
+static void
+xc_gga_x_wpbeh09_init(xc_func_type *p)
+{
+  xc_hyb_init_hybrid(p, 0.0);
+}
+
+static const char  *omega_names[]  = {"_omega"};
+static const char  *omega_desc[]   = {"screening parameter"};
+static const double omega_values[] = {0.0};
+
+#ifdef __cplusplus
+extern "C"
+#endif
+const xc_func_info_type xc_func_info_gga_x_wpbeh09 = {
+  XC_GGA_X_WPBEH09,
+  XC_EXCHANGE,
+  "short-range part of the PBE, smooth 2009 gradient scaling (default w=0 gives PBEh)",
+  XC_FAMILY_GGA,
+  {&xc_ref_Heyd2003_8207, &xc_ref_Heyd2006_219906, &xc_ref_Ernzerhof1998_3313, &xc_ref_Henderson2009_044108, NULL},
+  XC_FLAGS_3D | MAPLE2C_FLAGS,
+  1e-14,
+  {1, omega_names, omega_desc, omega_values, set_ext_params_cpy_omega},
+  xc_gga_x_wpbeh09_init, NULL,
+  NULL, &work_gga, NULL
+};
diff --git a/src/hyb_gga_xc_hse06_09.c b/src/hyb_gga_xc_hse06_09.c
new file mode 100644
index 000000000..f8c1ddb2b
--- /dev/null
+++ b/src/hyb_gga_xc_hse06_09.c
@@ -0,0 +1,70 @@
+/*
+ This Source Code Form is subject to the terms of the Mozilla Public
+ License, v. 2.0. If a copy of the MPL was not distributed with this
+ file, You can obtain one at http://mozilla.org/MPL/2.0/.
+*/
+
+#include "util.h"
+#include "xc_funcs.h"
+
+#define XC_HYB_GGA_XC_HSE06_09 791 /* HSE06 with the smooth reduced-gradient scaling of Henderson et al 2009 */
+
+/* HSE06 (hyb_gga_xc_hse.c) with both wPBEh pieces replaced by
+   gga_x_wpbeh09, i.e. eq. (9) of JCP 131, 044108 (2009). That paper
+   applies the scaling to the screened piece; applying it to the omega = 0
+   piece as well follows what gga_x_wpbeh does for HSE06. */
+
+static const char  *hse_names[]  = {"_beta", "_omega_HF", "_omega_PBE"};
+static const char  *hse_desc[]   = {
+  "Mixing parameter",
+  "Screening parameter for HF",
+  "Screening parameter for PBE"
+};
+static const double hse06_values[] = {0.25, 0.11, 0.11};
+
+static void
+hyb_gga_xc_hse06_09_init(xc_func_type *p)
+{
+  int    funcs_id  [3] = {XC_GGA_X_WPBEH09, XC_GGA_X_WPBEH09, XC_GGA_C_PBE};
+  double funcs_coef[3] = {1.0, 0.0, 1.0};
+
+  /* funcs_coef[1] is set by set_ext_params */
+  xc_mix_init(p, 3, funcs_id, funcs_coef);
+  xc_hyb_init_sr(p, 0.0, 0.0);
+}
+
+static void
+hse06_09_set_ext_params(xc_func_type *p, const double *ext_params)
+{
+  double beta, omega_HF, omega_PBE;
+
+  assert(p != NULL);
+
+  beta      = get_ext_param(p, ext_params, 0);
+  omega_HF  = get_ext_param(p, ext_params, 1);
+  omega_PBE = get_ext_param(p, ext_params, 2);
+
+  p->mix_coef[1] = -beta;
+
+  p->cam_beta  = beta;
+  p->cam_omega = omega_HF;
+
+  xc_func_set_ext_params_name(p->func_aux[0], "_omega", 0.0);
+  xc_func_set_ext_params_name(p->func_aux[1], "_omega", omega_PBE);
+}
+
+#ifdef __cplusplus
+extern "C"
+#endif
+const xc_func_info_type xc_func_info_hyb_gga_xc_hse06_09 = {
+  XC_HYB_GGA_XC_HSE06_09,
+  XC_EXCHANGE_CORRELATION,
+  "HSE06 with the smooth 2009 reduced-gradient scaling",
+  XC_FAMILY_HYB_GGA,
+  {&xc_ref_Heyd2003_8207, &xc_ref_Heyd2006_219906, &xc_ref_Krukau2006_224106, &xc_ref_Henderson2009_044108, NULL},
+  XC_FLAGS_3D | XC_FLAGS_HYB_CAM | XC_FLAGS_I_HAVE_EXC | XC_FLAGS_I_HAVE_VXC | XC_FLAGS_I_HAVE_FXC, /* wpbeh09 is order 2 */
+  1e-15,
+  {3, hse_names, hse_desc, hse06_values, hse06_09_set_ext_params},
+  hyb_gga_xc_hse06_09_init, NULL,
+  NULL, NULL, NULL
+};
