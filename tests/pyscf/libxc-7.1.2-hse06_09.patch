diff --git a/python/gga_exc/gga_x_wpbeh09.py b/python/gga_exc/gga_x_wpbeh09.py
new file mode 100644
index 000000000..c1fab33bb
--- /dev/null
+++ b/python/gga_exc/gga_x_wpbeh09.py
@@ -0,0 +1,48 @@
+"""
+ wPBEh with the reduced-gradient rescaling of Henderson, Izmaylov, Scalmani
+ and Scuseria, J. Chem. Phys. 131, 044108 (2009), eq. (9) -- the revision
+ that paper recommends over eq. (8) (s_scaling_2, used by gga_x_wpbeh)
+ "due to the discontinuities in s-bar at s = 1".
+
+ Everything except the scaling is gga_x_wpbeh, included verbatim.
+
+ This Source Code Form is subject to the terms of the Mozilla Public
+ License, v. 2.0. If a copy of the MPL was not distributed with this
+ file, You can obtain one at http://mozilla.org/MPL/2.0/.
+"""
+
+# type: gga_exc
+
+from libxc_codegen import *  # noqa: F401, F403
+
+include('gga_x_wpbeh')
+
+# Eq. (9): s_bar = s - (1 - exp(-s)) log(1 + exp(s - smax)), as s_scaling_3.
+# s_scaling_3 overflows exp(s - smax) in density tails (s is unbounded) and,
+# before that, loses all digits to s - log(...) cancellation. For s > smax use
+# the identity log(1 + e^x) = x + log1p(e^-x), which gives the equivalent
+#   s_bar = smax - log1p(e^(smax - s)) + e^(-s) log(1 + e^(s - smax)),
+# every term bounded. Both branches are the same analytic function, so the
+# split at s = smax is C-infinity; each branch's argument is clamped into its
+# own domain, the usual libxc piecewise pattern.
+
+@helper
+def s_scaling_3_safe(s):
+    hi = m_max(s, smax)
+    lo = m_min(s, smax)
+    return (
+        my_piecewise3(
+        s > smax,
+        smax - xc_log1p(exp(smax - hi)) + exp(-hi)*(hi - smax + xc_log1p(exp(smax - hi))),
+        lo + xc_expm1(-lo)*xc_log1p(exp(lo - smax))
+        )
+    )
+
+@helper
+def f_wpbeh09(rs, z, x):
+    return f_wpbeh0(nu(rs, z), m_max(Float('1e-15'), s_scaling_3_safe(gga_s(x))))
+
+def f(rs, z, xt, xs0, xs1):
+    return gga_exchange_nsp(f_wpbeh09, rs, z, xs0, xs1)
+
+TYPE = "gga_exc"
