# CCSD(T) size-scope rung (docs/CCSD_T_SIZE_SCOPE.md): water dimer,
# cc-pVTZ spherical, o 10 / v 106. Geometry: S22 water dimer, the ladder's
# rung: Total RCCSD(T) Energy -152.7012785674, equal to PySCF 2.15.
%begin_control
    basis       cc-pvtz
    calculation energy
    basis_type  spherical
%end_control

%begin_scf
    scf_type    rhf
    correlation ccsd(t)
    use_diis    .true.
    diis_dim    8
    save_checkpoint .false.
    guess       sad
    tol_energy  1.0e-11
    tol_density 1.0e-10
%end_scf

%begin_geom
    coord_type  cartesian
    coord_units angstrom
    use_symm    .false.
%end_geom

